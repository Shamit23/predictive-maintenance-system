# Copy to .env (Git-ignored) and fill in real values. Never commit .env.
# Replace CHANGE_ME with the password you chose for the pm_app role.
DATABASE_URL=postgresql+psycopg://pm_app:CHANGE_ME@localhost:5432/pm_dev
# Integration tests run against this DB. Its name MUST end with "_test" (tests refuse to run otherwise).
TEST_DATABASE_URL=postgresql+psycopg://pm_app:CHANGE_ME@localhost:5432/pm_test

# Protects POST /api/v1/readings, alert acknowledgement and the simulation worker (header X-API-Key).
# Required, at least 16 characters. Generate e.g. with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is REJECTED at startup (values starting with CHANGE_ME), so an unedited copy cannot run.
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Protects operator actions: start / stop / change speed of a simulation run (header X-Control-Key).
# Leave BLANK until you set a real key: operator controls then stay disabled (the API answers 503 control_disabled).
# When set it must be at least 16 characters, MUST differ from API_KEY, and must not start with CHANGE_ME.
# Never put it in frontend source.
CONTROL_API_KEY=

# Folder containing model artifact directories (relative paths resolve from the repo root).
MODEL_ARTIFACT_ROOT=ml/artifacts
# Optional. Required when several artifacts exist and none is marked active in the database.
ACTIVE_MODEL_VERSION=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Demonstration alert thresholds (cycles). NOT validated real-world safety limits.
RISK_WARNING_RUL=60
RISK_CRITICAL_RUL=30
# Minimum readings an engine needs before a prediction is made.
MIN_HISTORY_READINGS=1

# Simulation control plane limits (enforced by the server).
SIM_MAX_ENGINES=10
SIM_MIN_INTERVAL_SECONDS=0.1
SIM_MAX_INTERVAL_SECONDS=60
SIM_LEASE_SECONDS=30
SIM_QUEUE_TIMEOUT_SECONDS=60
SIM_STALE_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
